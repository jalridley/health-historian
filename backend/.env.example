# Copy to `.env` and fill with values from your Supabase project.
# Never commit `.env` with real secrets.

# Postgres (Supabase direct connection; use postgresql+psycopg for SQLAlchemy/SQLModel)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# JWT verification (GET /me and future protected routes)
# JWKS URL (Supabase public signing keys):
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Issuer must match the `iss` claim on access tokens (same project, auth v1):
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
